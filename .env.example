# Development-only example. Never commit production credentials.
STEEL_ENV=development
STEEL_API_RUN_ROOT=runtime/api
STEEL_API_STATE_DATABASE=runtime/api/state.db
STEEL_API_KEY=replace-with-a-long-random-value-for-production
STEEL_API_EMBEDDED_WORKER=true
STEEL_API_MAX_PRODUCTS=2000
STEEL_API_MAX_BODY_BYTES=5242880
STEEL_API_MAX_UPLOAD_BYTES=52428800
STEEL_API_RATE_LIMIT_PER_MINUTE=120
STEEL_JOB_MAX_ATTEMPTS=3
STEEL_MAX_ACTIVE_JOBS=1000
STEEL_REQUIRE_IDEMPOTENCY_KEY=false
STEEL_MINIMUM_FREE_DISK_BYTES=2147483648
STEEL_ALLOW_SAMPLE_DATA=true
STEEL_ALLOW_SIMULATION_EVENTS=true

# Optional local/private model provider. Advisory semantics only.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60

